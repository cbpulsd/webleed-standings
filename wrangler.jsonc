{
  "$schema": "node_modules/wrangler/config-schema.json",
  // TEST Worker, separate from the live page (webleed-s5-leaderboard).
  // Switch this to "webleed-s5-leaderboard" only when ready to replace the live page.
  "name": "webleed-standings-test",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // The standings page (public/) is served as static files; /api/* runs the Worker.
  "assets": { "directory": "./public" },

  // Saved standings for every track.
  "kv_namespaces": [
    { "binding": "STANDINGS", "id": "fbcf86f1f8254002bbbcc3dbccd33127" }
  ],

  // Times are UTC.
  //   "0 * * * *"   every hour on the hour: refresh live tracks
  //   "59 4 * * 0"  Saturday 11:59 PM Eastern (EST, UTC-5): lock tracks whose deadline it is
  //                 (during daylight time, Mar-Nov, Eastern 11:59 PM is "59 3 * * 0")
  "triggers": { "crons": ["0 * * * *", "59 4 * * 0"] },

  "observability": { "enabled": true }
}
