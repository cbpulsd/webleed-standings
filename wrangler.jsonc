{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The live Worker: webleed-s5-leaderboard.blastaa.workers.dev
  "name": "webleed-s5-leaderboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // The standings page (public/) is served as static files; /api/* runs the Worker.
  "assets": { "directory": "./public" },

  // Saved standings for every track.
  "kv_namespaces": [
    { "binding": "STANDINGS", "id": "fbcf86f1f8254002bbbcc3dbccd33127" }
  ],

  // Times are UTC.
  //   "0 * * * *"   every hour on the hour: refresh live tracks
  //   "59 4 * * SUN"  Saturday 11:59 PM Eastern (EST, UTC-5): lock tracks whose deadline it is
  // Cloudflare numbers weekdays 1-7 with Sunday = 1 (not 0), so use day names.
  "triggers": { "crons": ["0 * * * *", "59 4 * * SUN"] },

  "observability": { "enabled": true }
}
