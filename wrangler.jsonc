{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The live Worker: webleed-s5-leaderboard.blastaa.workers.dev
  "name": "webleed-s5-leaderboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // The standings page (public/) is served as static files; /api/* runs the Worker.
  "assets": { "directory": "./public" },

  // Saved standings for every track.
  "kv_namespaces": [
    { "binding": "STANDINGS", "id": "fbcf86f1f8254002bbbcc3dbccd33127" }
  ],

  // Times are UTC.
  //   "*/5 * * * *" every 5 minutes: refresh live tracks (also covers Saturday 11:50 and 11:55 PM)
  //   "59 4 * * SUN"  Saturday 11:59 PM Eastern: lock tracks whose deadline it is
  // Cloudflare numbers weekdays 1-7 with Sunday = 1 (not 0), so use day names.
  "triggers": { "crons": ["*/5 * * * *", "59 4 * * SUN"] },

  // Race day: one RaceRoom per track holds lineups and race times and pushes live updates.
  "durable_objects": { "bindings": [{ "name": "RACES_DO", "class_name": "RaceRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom"] }],

  "observability": { "enabled": true }
}
